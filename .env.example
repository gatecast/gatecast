# Copy this file to .env and fill in your own values.
# .env is in .gitignore — never commit it.

# OpenSky Network (create an API client in your OpenSky account)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Flight-status API (provider TBD)
FLIGHT_API_KEY=

# Database
DATABASE_URL=postgresql://gatecast:gatecast@localhost:5432/gatecast

# LLM API (for ml/ explanations)
LLM_API_KEY=

# Email alerts (provider TBD)
EMAIL_API_KEY=
